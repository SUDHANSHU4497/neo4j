# Copy this file to .env and fill in your values.

# Where the data comes from: "files" (the SENTINEL tables folder or zip) or "supabase"
SOURCE=files

# For SOURCE=files: the extracted tables folder, or the zip file
DATA_PATH=C:\Users\sudha\Downloads\Sentinel project data\sentinel_data\tables

# 0 = all 25,000 customers (about 3 minutes). A number like 2000 = faster run on a sample of customers.
# The sample keeps every transaction of each chosen customer, so the history features stay correct.
SAMPLE_CUSTOMERS=0

# Only for SOURCE=supabase (the same URL and key you used for python ingest.py all)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-key
# Schema the tables are in (public, or sentinel_demo if you used sql/schema.sql as is)
SUPABASE_SCHEMA=public

# Folder for the result CSV files
OUTPUT_DIR=outputs
