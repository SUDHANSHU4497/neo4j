# Copy this file to .env and fill in your values.
# Docker (local):  NEO4J_URI=neo4j://localhost:7687
# Aura:            NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io  (from the credentials file Aura gives you)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=NEO4J USERID
NEO4J_PASSWORD=PASSWORD

# Where the data comes from: "files" (the SENTINEL zip / tables folder) or "supabase"
SOURCE=files
DATA_PATH=C:\Users\sudha\Downloads\Sentinel project data.zip
NUM_PARTS=2

# Only for SOURCE=supabase (the same URL and key you used for python ingest.py all)
SOURCE="supabase"
SUPABASE_URL="SUPABASE URL"
SUPABASE_KEY="ANOS KEY"
SAMPLE_SIZE=10000